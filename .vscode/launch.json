{
  "version": "1.0.0",
  "configurations": [
    {
      "name": "debug-server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "localRoot": "${workspaceFolder}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "debug-client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "cwd": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceRoot}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "All",
      "configurations": ["debug-server-side", "debug-client-side"]
    }
  ]
}
